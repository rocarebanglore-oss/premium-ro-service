---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Contact Us | RO Service Support">
  <section class="page-section" style="background: #f8fafc;">
    <div class="container">
      <h1 class="page-title" style="text-align: center;">Contact Us</h1>
      <p class="page-content" style="text-align: center; max-width: 600px; margin: 0 auto 40px auto;">Have a question or need to book a technician? Fill out the form below or call us directly. We are available 24x7 for your service needs.</p>
      
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px; max-width: 900px; margin: 0 auto;">
        
        <!-- Contact Info -->
        <div style="background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
          <h2 style="color: #0f172a; margin-bottom: 20px;">Get in Touch</h2>
          <p style="margin-bottom: 15px;"><strong>📞 Phone:</strong> <a href="tel:+919999999999" style="color: #2563eb; text-decoration: none;">+91 99999 99999</a></p>
          <p style="margin-bottom: 15px;"><strong>✉️ Email:</strong> support@roservicesupport.co.in</p>
          <p style="margin-bottom: 15px;"><strong>📍 Address:</strong> Bangalore, Karnataka</p>
          <p style="margin-bottom: 15px;"><strong>⏰ Hours:</strong> 24x7 Available</p>
        </div>

        <!-- Simple Form -->
        <div style="background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
          <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" style="display: flex; flex-direction: column; gap: 15px;">
            <input type="text" name="name" placeholder="Your Name" required style="padding: 12px; border: 1px solid #cbd5e1; border-radius: 6px;" />
            <input type="tel" name="phone" placeholder="Mobile Number" required style="padding: 12px; border: 1px solid #cbd5e1; border-radius: 6px;" />
            <textarea name="message" rows="4" placeholder="Your Message" required style="padding: 12px; border: 1px solid #cbd5e1; border-radius: 6px;"></textarea>
            <button type="submit" style="background: #2563eb; color: white; padding: 14px; border: none; border-radius: 6px; font-weight: bold; cursor: pointer;">Send Message</button>
          </form>
        </div>

      </div>
    </div>
  </section>
</Layout>