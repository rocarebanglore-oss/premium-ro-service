---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Cookie Policy | RO Service Support">
  <section class="page-section">
    <div class="container">
      <h1 class="page-title">Cookie Policy</h1>
      <div class="page-content">
        <p>This Cookie Policy explains how RO Service Support uses cookies and similar technologies when you visit our website.</p>
        
        <h2>1. What are Cookies?</h2>
        <p>Cookies are small text files stored on your device (computer or mobile) when you visit a website. They help the website remember your preferences and understand how you interact with the site.</p>

        <h2>2. How We Use Cookies</h2>
        <p>We use cookies for:</p>
        <ul>
          <li><strong>Analytics:</strong> To understand how visitors navigate our website so we can improve it (using tools like Google Analytics).</li>
          <li><strong>Advertising:</strong> To show you relevant ads on platforms like Google (using Google Ads tracking).</li>
        </ul>

        <h2>3. Managing Cookies</h2>
        <p>You can choose to disable or delete cookies through your browser settings. However, doing so may affect the functionality of some parts of our website.</p>
      </div>
    </div>
  </section>
</Layout>