---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Water Purifier Service Center | RO Service Support">
  
  <!-- 1. HERO SECTION -->
  <section class="hero-section">
    <div class="bg-overlay"></div>
    <div class="container hero-container">
      <div class="hero-text">
        <p class="hero-subtitle">RO SERVICE CUSTOMER SUPPORT</p>
        <h1>Water Purifier Service & Repair</h1>
        <h2 class="price-offer">Starting at just ₹299</h2>
        <p class="hero-desc">
          Looking for a reliable RO service in Bangalore? Get same-day doorstep service with certified technicians, genuine parts, and a 90-day warranty included. 20,000+ customers trust us for safe drinking water.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. FORM SECTION -->
  <section class="form-section" id="book-service">
    <div class="container">
      <div class="form-card" id="form-card">
        <h2>Request a Service</h2>
        <p class="form-desc">Fill in your details and our team will contact you shortly.</p>
        
        <form id="serviceForm" class="service-form">
          
          <input type="hidden" name="_subject" id="emailSubject" value="New Service Request">
          <input type="hidden" name="_template" value="table">
          <input type="hidden" name="_captcha" value="false">
          <input type="hidden" name="Brand/Product" value="Water Purifier Service">
          <input type="hidden" name="Booking_ID" id="hiddenBookingId" value="">

          <div class="input-icon-group">
            <svg fill="none" stroke="#64748b" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            <input type="text" name="Name" placeholder="Your Name" required />
          </div>

          <div class="input-icon-group">
            <svg fill="none" stroke="#64748b" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            <input type="tel" name="Phone" id="phoneInput" placeholder="10-Digit Mobile Number" pattern="[0-9]{10}" maxlength="10" minlength="10" title="Please enter exactly 10 digits" required />
          </div>

          <div class="input-icon-group">
            <svg fill="none" stroke="#64748b" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <input type="text" name="PinCode" placeholder="Pin Code" required />
          </div>

          <div class="input-icon-group">
            <svg fill="none" stroke="#64748b" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
            <input type="text" name="Address" placeholder="Full Address" required />
          </div>

          <button type="submit" class="submit-btn" id="submitBtn">
            <span id="btnText">Submit Request</span>
            <svg id="btnIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- 2.5 TRUST & STATS SECTION -->
  <section class="trust-stats-section">
    <div class="container">
      
      <div class="section-divider">
        <span class="diamond"></span>
      </div>

      <h2 class="trust-title">Why Bangalore Families Trust Us</h2>
      
      <div class="stats-grid">
        <div class="stat-item">
          <h3 class="stat-number">15+</h3>
          <p class="stat-label">YEARS<br/>EXPERIENCE</p>
        </div>
        <div class="stat-item">
          <h3 class="stat-number">20,000+</h3>
          <p class="stat-label">HAPPY<br/>FAMILIES</p>
        </div>
        <div class="stat-item">
          <h3 class="stat-number">4.8★</h3>
          <p class="stat-label">AVERAGE<br/>RATING</p>
        </div>
      </div>

      <div class="service-image-wrapper">
        <!-- 🔥 PERFECT IMAGE OPTIMIZATION 🔥 -->
        <img 
          src="/technician.webp" 
          alt="Certified RO Technician repairing water purifier" 
          class="service-img" 
          loading="lazy" 
          width="800" 
          height="400" 
        />
      </div>

      <div class="trust-bottom-text">
        <h3>Certified & Verified Technicians</h3>
        <p>Trained on all major water purifier brands</p>
      </div>

      <div class="section-divider bottom-divider">
        <span class="diamond"></span>
      </div>

    </div>
  </section>

  <!-- 3. SERVICES SECTION -->
  <section class="services-article-section" id="services">
    <div class="container">
      <h2 class="article-main-title">Expert Water Purifier Service & Repair Solutions</h2>
      <p class="article-text">
        Searching for a trusted <strong>RO service near me</strong>? We provide top-rated doorstep repair, installation, and maintenance for all major water purifier brands. Whether your purifier is leaking, making noise, or giving bad-tasting water, our certified technicians are just a call away. Get your water purifier fixed today with a <strong>90-day service warranty</strong> and 100% genuine spare parts.
      </p>
      <div class="service-text-block">
        <h3>1. RO Repair & Filter Replacement</h3>
        <p class="article-text">
          Is your RO water purifier not working properly? We offer fast, same-day <strong>water purifier repair</strong> at your doorstep. From fixing motor issues and water leakage to replacing clogged filters and membranes, we do it all. Our technicians use advanced TDS meters to ensure your water is perfectly safe to drink. Every repair is backed by a written 90-day warranty for your peace of mind.
        </p>
      </div>
      <div class="service-text-block">
        <h3>2. New RO Installation & Setup</h3>
        <p class="article-text">
          Bought a new RO system? Don't let a local plumber ruin it. We provide professional <strong>new RO installation services</strong> for homes and offices. Our team handles the complete setup, checks the inlet water pressure, calibrates the TDS levels, and gives you a full demonstration of how to use and maintain the machine. We also offer free water testing after installation.
        </p>
      </div>
      <div class="service-text-block">
        <h3>3. Annual Maintenance Plans (AMC)</h3>
        <p class="article-text">
          To keep your purifier running smoothly year-round, we offer affordable <strong>AMC plans</strong>. Regular servicing prevents sudden breakdowns and extends the life of your RO. Our AMC includes scheduled filter cleaning, priority customer support, and discounts on genuine spare parts.
        </p>
      </div>
    </div>
  </section>

  <!-- 3.2 COMMON PROBLEMS SECTION -->
  <section class="problems-section">
    <div class="container">
      <h2 class="article-main-title">Common RO Problems We Fix</h2>
      <p class="article-text section-subtitle">
        Is your water purifier giving you trouble? We can fix any issue on the same day. Here are some of the most common problems our experts solve:
      </p>
      
      <div class="problems-grid">
        <div class="problem-card">
          <div class="problem-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <div>
            <h3>Low Water Flow</h3>
            <p>Is your RO filling up very slowly? We fix clogged filters, low pressure, or faulty pumps.</p>
          </div>
        </div>
        <div class="problem-card">
          <div class="problem-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
          </div>
          <div>
            <h3>Water Leakage</h3>
            <p>Leaking pipes or water dripping from the machine? We replace damaged seals and tubing.</p>
          </div>
        </div>
        <div class="problem-card">
          <div class="problem-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <div>
            <h3>Bad Taste or Smell</h3>
            <p>Water tasting weird or smelling bad? It might be time to change the carbon or membrane filter.</p>
          </div>
        </div>
        <div class="problem-card">
          <div class="problem-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <div>
            <h3>Motor Not Working</h3>
            <p>Is the RO motor dead or making loud noise? We repair or replace the motor with genuine parts.</p>
          </div>
        </div>
        <div class="problem-card">
          <div class="problem-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
          </div>
          <div>
            <h3>Blinking Indicator Lights</h3>
            <p>If the lights on your purifier are blinking constantly, it indicates a filter or sensor issue.</p>
          </div>
        </div>
        <div class="problem-card">
          <div class="problem-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <div>
            <h3>High TDS Levels</h3>
            <p>Water not pure enough? Our technicians will test the TDS and replace the membrane if needed.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3.5 WHY CHOOSE US SECTION -->
  <section class="why-choose-section">
    <div class="container">
      <h2 class="article-main-title">Why Choose Our Water Purifier Service Center?</h2>
      <p class="article-text section-subtitle">
        Finding a reliable RO service can be stressful. Here is why over 20,000+ families trust us for their water purifier needs:
      </p>
      <div class="why-grid">
        <div class="why-card">
          <div class="check-icon">✔</div>
          <div>
            <h3>Same-Day Doorstep Service</h3>
            <p>No more waiting for days. Book before 2 PM and get your purifier fixed the very same day.</p>
          </div>
        </div>
        <div class="why-card">
          <div class="check-icon">✔</div>
          <div>
            <h3>Verified & Background-Checked Technicians</h3>
            <p>Our professionals are fully trained, certified, and background-verified for your family's safety.</p>
          </div>
        </div>
        <div class="why-card">
          <div class="check-icon">✔</div>
          <div>
            <h3>100% Genuine Spare Parts</h3>
            <p>We never use local duplicate filters. We install only original membranes and parts that last longer.</p>
          </div>
        </div>
        <div class="why-card">
          <div class="check-icon">✔</div>
          <div>
            <h3>90-Day Written Warranty</h3>
            <p>Every repair and part replacement comes with a 90-day service warranty for complete peace of mind.</p>
          </div>
        </div>
        <div class="why-card">
          <div class="check-icon">✔</div>
          <div>
            <h3>Transparent Pricing</h3>
            <p>Know the exact cost before we start the work. Absolutely no hidden visiting or inspection charges.</p>
          </div>
        </div>
        <div class="why-card">
          <div class="check-icon">✔</div>
          <div>
            <h3>All Brands Supported</h3>
            <p>From Kent and Aquaguard to Pureit and local brands, our experts can service any RO model.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3.8 TESTIMONIALS SECTION -->
  <section class="testimonials-section">
    <div class="container">
      <h2 class="article-main-title">What Our Customers Say</h2>
      <p class="article-text section-subtitle">Don't just take our word for it. Here is what our happy customers have to say about our service.</p>
      
      <div class="testimonials-grid">
        <div class="review-card">
          <div class="stars">⭐⭐⭐⭐⭐</div>
          <p class="review-text">"My RO stopped working suddenly. I booked a service online and the technician arrived within 2 hours. Very professional and fixed the issue quickly. Highly recommended!"</p>
          <div class="review-author">
            <span class="author-name">Rahul Sharma</span>
            <span class="author-location">Indiranagar, Bangalore</span>
          </div>
        </div>
        <div class="review-card">
          <div class="stars">⭐⭐⭐⭐⭐</div>
          <p class="review-text">"I was worried about the water quality. The technician did a TDS test for free and explained exactly what parts needed changing. No hidden charges at all. Great service."</p>
          <div class="review-author">
            <span class="author-name">Priya Patel</span>
            <span class="author-location">Whitefield, Bangalore</span>
          </div>
        </div>
        <div class="review-card">
          <div class="stars">⭐⭐⭐⭐⭐</div>
          <p class="review-text">"We have been using their AMC plan for our office purifier for the last 6 months. The service is always on time, and the technicians are very polite and knowledgeable."</p>
          <div class="review-author">
            <span class="author-name">Amit Kumar</span>
            <span class="author-location">Koramangala, Bangalore</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. FAQ SECTION -->
  <section class="faq-section" id="faq">
    <div class="container">
      <h2 class="article-main-title">Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-question">
            What services does your water purifier service center provide?
            <span class="faq-icon">+</span>
          </summary>
          <div class="faq-answer">
            <p>We provide complete RO care, including new installation, repair for all brands, filter and membrane replacement, and annual maintenance contracts (AMC).</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">
            How do I find a water purifier service center near me?
            <span class="faq-icon">+</span>
          </summary>
          <div class="faq-answer">
            <p>You are already on the right page! We provide doorstep service across Bangalore. Just fill out the form above or call us to book a technician.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">
            Do you provide doorstep service?
            <span class="faq-icon">+</span>
          </summary>
          <div class="faq-answer">
            <p>Yes, we provide 100% doorstep service. You don't need to remove your purifier; our expert will come to your home and fix it there.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">
            How much does RO repair cost?
            <span class="faq-icon">+</span>
          </summary>
          <div class="faq-answer">
            <p>The basic visiting and inspection charge is just ₹299. If any part needs replacement, we will tell you the exact cost upfront before starting the work.</p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- 5. SERVICE AREAS SECTION -->
  <section class="service-areas-section">
    <div class="container">
      <div class="section-header" style="text-align: center; margin-bottom: 30px;">
        <h2 class="article-main-title" style="text-align: center; margin-bottom: 10px;">Our Service Areas in Bangalore</h2>
        <p class="article-text" style="text-align: center;">We provide fast, same-day doorstep RO repair and installation services in all these locations.</p>
      </div>
      
      <div class="areas-grid">
        <span class="area-tag">📍 Indiranagar</span>
        <span class="area-tag">📍 Koramangala</span>
        <span class="area-tag">📍 Whitefield</span>
        <span class="area-tag">📍 HSR Layout</span>
        <span class="area-tag">📍 BTM Layout</span>
        <span class="area-tag">📍 Marathahalli</span>
        <span class="area-tag">📍 Electronic City</span>
        <span class="area-tag">📍 Jayanagar</span>
        <span class="area-tag">📍 JP Nagar</span>
        <span class="area-tag">📍 Banashankari</span>
        <span class="area-tag">📍 Hebbal</span>
        <span class="area-tag">📍 Yelahanka</span>
        <span class="area-tag">📍 Rajajinagar</span>
        <span class="area-tag">📍 Malleshwaram</span>
        <span class="area-tag">📍 Bellandur</span>
      </div>
    </div>
  </section>

  <!-- 6. SEO KEYWORDS SECTION -->
  <section class="seo-keywords-section">
    <div class="container">
      <h2 class="keyword-title">Popular Searches</h2>
      <div class="keyword-tags">
        <span>RO Service Near Me</span>
        <span>Water Purifier Repair Bangalore</span>
        <span>RO Service Center</span>
        <span>Kent RO Service</span>
        <span>Aquaguard Service</span>
        <span>Pureit RO Repair</span>
        <span>RO Installation Near Me</span>
        <span>Water Purifier AMC</span>
        <span>RO Filter Replacement</span>
        <span>Best RO Service in Bangalore</span>
        <span>Same Day RO Repair</span>
        <span>Doorstep Water Purifier Service</span>
      </div>
    </div>
  </section>

</Layout>

<script is:inline>
  const phoneInput = document.getElementById('phoneInput');
  phoneInput.addEventListener('input', function (e) {
    this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);
  });

  document.getElementById('serviceForm').addEventListener('submit', async function(e) {
    e.preventDefault(); 
    
    // ⭐ CONVERSION BLOCK CHECK (Nayi Website)
    if (window.WM_BLOCKED === true) {
      alert('Access Restricted');
      return false;
    }

    if (phoneInput.value.length !== 10) {
      alert("Please enter a valid 10-digit mobile number.");
      return;
    }

    const bookingId = 'RO-' + Math.floor(100000 + Math.random() * 900000);
    document.getElementById('hiddenBookingId').value = bookingId;
    document.getElementById('emailSubject').value = `New Service Request: ${bookingId}`;
    
    const btn = document.getElementById('submitBtn');
    const btnText = document.getElementById('btnText');
    const btnIcon = document.getElementById('btnIcon');
    
    btnText.innerText = 'Submitting...';
    btnIcon.style.display = 'none';
    btn.disabled = true;
    btn.style.opacity = '0.7';

    const formData = new FormData(this);

    try {
      const response = await fetch("https://formsubmit.co/ajax/syedsmaula786@gmail.com", {
        method: "POST",
        headers: { 'Accept': 'application/json' },
        body: formData
      });

      if (response.ok) {
        // ⭐ GOOGLE ADS CONVERSION EVENT
        if (typeof gtag === 'function') {
          gtag('event', 'conversion', { 'send_to': 'AW-NAYA_ID_YAHAN/NAYA_LABEL_YAHAN' });
        }
        window.location.href = `/thank-you?id=${bookingId}`;
      } else {
        throw new Error('Form submission failed');
      }
    } catch (error) {
      alert("Oops! Something went wrong. Please try again or call us directly at +91 7090170092.");
      btnText.innerText = 'Submit Request';
      btnIcon.style.display = 'block';
      btn.disabled = false;
      btn.style.opacity = '1';
    }
  });
</script>

<style>
  /* 1. HERO SECTION */
  .hero-section {
    position: relative;
    background-image: url('/background.webp'); 
    background-size: cover;
    background-position: center top;
    background-attachment: fixed;
    padding: 40px 0 60px 0; 
  }

  .bg-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to right, rgba(255,255,255,0.85) 0%, rgba(255,255,255,0.6) 50%, rgba(240,249,255,0.1) 100%);
    z-index: 1;
  }

  .hero-container { position: relative; z-index: 2; }
  .hero-text { max-width: 100%; text-align: center; }

  .hero-subtitle {
    color: #1e3a8a; font-size: 0.85rem; font-weight: 700;
    letter-spacing: 1px; margin-bottom: 15px; text-transform: uppercase;
  }

  .hero-text h1 {
    font-size: clamp(1.2rem, 5vw, 2.8rem); color: #0f172a;
    font-weight: 800; line-height: 1.2; margin-bottom: 15px; white-space: nowrap;
  }

  .price-offer {
    font-size: clamp(1.1rem, 4vw, 1.5rem); color: #2563eb;
    font-weight: 700; margin-bottom: 20px;
  }

  .hero-desc {
    font-size: 1.1rem; color: #475569; line-height: 1.6;
    text-align: justify; text-align-last: center; 
    max-width: 700px; margin: 0 auto; font-weight: 500;
  }

  /* 2. FORM SECTION */
  .form-section { background: #f8fafc; padding: 40px 0 60px 0; }

  .form-card {
    background: #ffffff; border-radius: 16px; padding: 40px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    max-width: 600px; margin: 0 auto; border: 1px solid #f1f5f9;
  }

  .form-card h2 { font-size: 1.8rem; color: #0f172a; font-weight: 800; margin-bottom: 8px; text-align: center; }
  .form-desc { color: #64748b; font-size: 0.95rem; margin-bottom: 24px; text-align: center; }

  .service-form { display: flex; flex-direction: column; gap: 16px; }

  .input-icon-group { position: relative; display: flex; align-items: center; }
  .input-icon-group svg { position: absolute; left: 16px; width: 20px; height: 20px; z-index: 2; }
  
  .input-icon-group input {
    width: 100%; padding: 16px 16px 16px 48px;
    border: 1px solid #cbd5e1; border-radius: 10px;
    font-size: 16px; font-family: inherit; background: #ffffff;
    color: #0f172a; outline: none; transition: border-color 0.2s;
  }
  .input-icon-group input:focus { border-color: #2563eb; box-shadow: 0 0 0 3px #eff6ff; }

  .submit-btn {
    background: #2563eb; color: white; padding: 16px;
    border: none; border-radius: 10px; font-size: 1.1rem; font-weight: 600;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    gap: 10px; margin-top: 10px; transition: background 0.2s;
  }
  .submit-btn:hover { background: #1d4ed8; }
  .submit-btn svg { width: 20px; height: 20px; }

  /* 2.5 TRUST & STATS CSS */
  .trust-stats-section {
    padding: 60px 0;
    background: #ffffff;
    text-align: center;
  }
  
  .section-divider {
