---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Booking Confirmed | RO Service Support">
  <section class="thank-you-section">
    <div class="container">
      <div class="thank-you-card">
        
        <div class="success-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>

        <h1>Booking Confirmed!</h1>
        <h2>Thank you for choosing us.</h2>
        
        <p class="thank-you-desc">
          We have received your details. Our team will call you within <strong>10-15 minutes</strong> to confirm your service time.
        </p>

        <div id="bookingIdBox" class="booking-box" style="display: none;">
          <p>Your Booking ID</p>
          <h3 id="bookingIdDisplay">RO-XXXXXX</h3>
          <span class="save-text">Please save this ID for future reference.</span>
        </div>

        <div class="action-buttons">
          <a href="tel:+917090170092" class="btn-primary">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            Call Us Now
          </a>
          <a href="/" class="btn-secondary">Back to Home</a>
        </div>

      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  const urlParams = new URLSearchParams(window.location.search);
  const bookingId = urlParams.get('id');
  
  if (bookingId) {
    document.getElementById('bookingIdBox').style.display = 'block';
    document.getElementById('bookingIdDisplay').innerText = bookingId;
  } else {
    document.getElementById('bookingIdBox').style.display = 'block';
  }
</script>

<style>
  .thank-you-section { padding: 80px 0; background: #f8fafc; min-height: calc(100vh - 80px); display: flex; align-items: center; }
  .thank-you-card { background: #ffffff; max-width: 600px; margin: 0 auto; padding: 50px 40px; border-radius: 20px; box-shadow: 0 15px 40px rgba(0,0,0,0.08); text-align: center; border: 1px solid #f1f5f9; }
  .success-icon { width: 80px; height: 80px; background: #dcfce7; color: #16a34a; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 25px auto; }
  .success-icon svg { width: 40px; height: 40px; }
  h1 { font-size: 2.5rem; color: #0f172a; font-weight: 800; margin-bottom: 10px; line-height: 1.2; }
  h2 { font-size: 1.2rem; color: #2563eb; font-weight: 700; margin-bottom: 20px; }
  .thank-you-desc { font-size: 1.05rem; color: #475569; line-height: 1.6; margin-bottom: 30px; }
  .booking-box { background: #eff6ff; border: 2px dashed #93c5fd; padding: 20px 30px; border-radius: 12px; margin-bottom: 35px; }
  .booking-box p { font-size: 0.85rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; }
  .booking-box h3 { font-size: 2.2rem; color: #1d4ed8; font-weight: 800; letter-spacing: 2px; margin-bottom: 8px; }
  .booking-box .save-text { font-size: 0.8rem; color: #64748b; font-style: italic; }
  .action-buttons { display: flex; flex-direction: column; gap: 15px; }
  .btn-primary { background: #2563eb; color: white; padding: 16px 24px; border-radius: 10px; text-decoration: none; font-weight: 600; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; gap: 10px; transition: background 0.2s; }
  .btn-primary:hover { background: #1d4ed8; }
  .btn-primary svg { width: 22px; height: 22px; }
  .btn-secondary { background: #ffffff; color: #475569; padding: 16px 24px; border-radius: 10px; text-decoration: none; font-weight: 600; font-size: 1.1rem; border: 1px solid #cbd5e1; transition: all 0.2s; }
  .btn-secondary:hover { background: #f8fafc; color: #0f172a; }
  @media (max-width: 600px) {
    .thank-you-card { padding: 40px 20px; }
    h1 { font-size: 2rem; }
    h2 { font-size: 1.1rem; }
    .booking-box h3 { font-size: 1.8rem; }
  }
</style>---
