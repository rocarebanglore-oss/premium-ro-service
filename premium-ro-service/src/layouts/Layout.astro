    <!-- ⭐ CONVERSION BLOCK SCRIPT FOR FLOATING BUTTONS -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        const isBlocked = function() { return window.WM_BLOCKED === true; };
        
        document.querySelectorAll('a[href^="tel:"], a[href*="wa.me"], a[href*="whatsapp"]').forEach(function(link) {
          link.addEventListener('click', function(e) {
            if (isBlocked()) {
              e.preventDefault();
              alert('Access Restricted');
              return false;
            }
            if (link.href.startsWith('tel:') && typeof gtag === 'function') {
              // ⚠️ Yahan bhi ASLI ID aur LABEL daalna
              gtag('event', 'conversion', { 'send_to': 'AW-NAYA_ID_YAHAN/NAYA_LABEL_YAHAN' });
            }
          });
        });
      });
    </script>

    <style is:global>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: "Inter", system-ui, sans-serif; color: #334155; background: #ffffff; -webkit-font-smoothing: antialiased; }
      .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }

      /* MAIN HEADER */
      .site-header { background: #ffffff; padding: 15px 0; border-bottom: 1px solid #f1f5f9; position: relative; z-index: 100; }
      .header-inner { display: flex; justify-content: space-between; align-items: center; }

      .logo { display: flex; align-items: center; text-decoration: none; }
      .logo-text { display: flex; flex-direction: column; justify-content: center; }
      .logo-title { font-size: 1.4rem; font-weight: 800; color: #0b1c36; line-height: 1.1; }
      .logo-subtitle { font-size: 0.85rem; font-weight: 700; color: #0ea5e9; display: flex; align-items: center; gap: 6px; margin-top: 4px; }
      .online-dot { width: 8px; height: 8px; background: #22c55e; border-radius: 50%; }

      .header-icons { display: flex; align-items: center; gap: 20px; color: #475569; position: relative; }
      .header-icons svg { width: 26px; height: 26px; cursor: pointer; transition: color 0.2s; }
      .header-icons svg:hover { color: #0ea5e9; }
      .icon-link { color: inherit; display: flex; }
      
      .menu-checkbox { display: none; }
      .menu-btn { cursor: pointer; display: flex; color: inherit; margin-left: 5px; }
      
      .nav-dropdown { display: none; position: absolute; top: 45px; right: 0; background: #ffffff; box-shadow: 0 10px 25px rgba(0,0,0,0.1); border-radius: 10px; min-width: 200px; flex-direction: column; padding: 10px 0; border: 1px solid #e2e8f0; }
      .nav-dropdown a { padding: 12px 20px; color: #334155; text-decoration: none; font-weight: 600; font-size: 0.95rem; transition: background 0.2s; }
      .nav-dropdown a:hover { background: #f8fafc; color: #0ea5e9; }
      .menu-checkbox:checked ~ .nav-dropdown { display: flex; }

      /* FOOTER */
      .site-footer { background: #0f172a; color: #94a3b8; padding: 60px 0 20px 0; }
      .footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1.5fr; gap: 40px; margin-bottom: 40px; }
      .brand-logo { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
      .logo-icon { background: #1e3a8a; color: #facc15; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 8px; font-size: 1.2rem; }
      .brand-logo h2 { color: #ffffff; font-size: 1.5rem; font-weight: 700; }
      .brand-desc { font-size: 0.95rem; line-height: 1.6; }
      .footer-links { display: flex; flex-direction: column; gap: 12px; }
      .footer-links h3 { color: #facc15; font-size: 1.2rem; font-weight: 700; margin-bottom: 8px; }
      .footer-links a { color: #94a3b8; text-decoration: none; font-size: 0.95rem; transition: color 0.2s; }
      .footer-links a:hover { color: #ffffff; }
      .footer-contact { display: flex; flex-direction: column; gap: 16px; }
      .footer-contact h3 { color: #facc15; font-size: 1.2rem; font-weight: 700; margin-bottom: 4px; }
      .contact-item { display: flex; align-items: center; gap: 12px; color: #94a3b8; text-decoration: none; font-size: 0.95rem; }
      .contact-item:hover { color: #ffffff; }
      .contact-item svg { width: 20px; height: 20px; color: #facc15; }
      .footer-disclaimer { font-size: 0.85rem; line-height: 1.6; padding: 20px 0; border-top: 1px solid rgba(255,255,255,0.1); border-bottom: 1px solid rgba(255,255,255,0.1); margin-bottom: 20px; color: #64748b; }
      .footer-disclaimer strong { color: #94a3b8; }
      .footer-bottom { display: flex; justify-content: space-between; align-items: center; font-size: 0.9rem; }
      .bottom-links { display: flex; gap: 20px; }
      .bottom-links a { color: #94a3b8; text-decoration: none; transition: color 0.2s; }
      .bottom-links a:hover { color: #ffffff; }

      /* FLOATING BUTTONS CSS */
      .floating-actions { position: fixed; bottom: 25px; left: 25px; display: flex; flex-direction: column; gap: 15px; z-index: 999; }
      .float-btn { border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; box-shadow: 0 4px 15px rgba(0,0,0,0.3); transition: transform 0.2s; }
      .float-btn:hover { transform: scale(1.1); }
      .wa-btn { background: #25D366; width: 50px; height: 50px; }
      .wa-btn svg { width: 26px; height: 26px; }
      .call-btn { background: #1e3a8a; width: 60px; height: 60px; animation: pulse 2s infinite; }
      .call-btn svg { width: 30px; height: 30px; }

      @keyframes pulse {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(30, 58, 138, 0.7); }
        70% { transform: scale(1.05); box-shadow: 0 0 0 15px rgba(30, 58, 138, 0); }
        100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(30, 58, 138, 0); }
      }

      /* PAGE STYLES */
      .page-section { padding: 60px 0; min-height: 60vh; }
      .page-title { font-size: 2.5rem; color: #0f172a; font-weight: 800; margin-bottom: 20px; }
      .page-content h2 { font-size: 1.5rem; color: #1e3a8a; margin: 30px 0 15px 0; }
      .page-content p, .page-content ul { color: #475569; font-size: 1.05rem; line-height: 1.8; margin-bottom: 15px; text-align: justify; }
      .page-content ul { padding-left: 20px; }

      @media (max-width: 768px) {
        .logo-title { font-size: 1.15rem; }
        .logo-subtitle { font-size: 0.75rem; }
        .header-icons { gap: 12px; }
        .header-icons svg { width: 22px; height: 22px; }
        .footer-grid { grid-template-columns: 1fr; gap: 30px; text-align: left; }
        .footer-bottom { flex-direction: column; gap: 15px; text-align: center; }
        .floating-actions { bottom: 20px; left: 20px; gap: 10px; }
        .wa-btn { width: 45px; height: 45px; }
        .wa-btn svg { width: 22px; height: 22px; }
        .call-btn { width: 55px; height: 55px; }
        .call-btn svg { width: 26px; height: 26px; }
      }
    </style>
  </body>
</html>
